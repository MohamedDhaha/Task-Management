# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# =========================
# Node / Package managers
# =========================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json
pnpm-lock.yaml
yarn.lock

# =========================
# Next.js / Build
# =========================
/.next/
/out/
/build/
/dist/
/.cache/

# =========================
# Testing / Coverage
# =========================
/coverage
/jest.config.js
*.test.js
*.spec.js
*.test.ts
*.spec.ts
*.test.tsx
*.spec.tsx

# =========================
# Environment / Secrets
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.crt

# =========================
# Logs / Debug
# =========================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.tmp
*.bak
*.orig

# =========================
# OS Generated
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# TypeScript
# =========================
*.tsbuildinfo
next-env.d.ts

# =========================
# Vercel / Deployment
# =========================
.vercel
.vercel_build_output

# =========================
